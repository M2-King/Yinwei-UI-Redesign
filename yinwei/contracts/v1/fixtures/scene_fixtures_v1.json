    {
      "id": "apply_newer_revision",
      "kind": "revision",
      "appliedRevision": 4,
      "incomingRevision": 5,
      "expect": { "apply": true }
    },
    {
      "id": "reject_stale_revision",
      "kind": "revision",
      "appliedRevision": 4,
      "incomingRevision": 3,
      "expect": { "apply": false, "reason": "stale_revision" }
    },
    {
      "id": "reject_equal_revision",
      "kind": "revision",
      "appliedRevision": 4,
      "incomingRevision": 4,
      "expect": { "apply": false, "reason": "stale_revision" }
    },
    {
      "id": "accept_revision_gap",
      "kind": "revision",
      "appliedRevision": 4,
      "incomingRevision": 7,
      "expect": { "apply": true, "discontinuity": true }
    }
