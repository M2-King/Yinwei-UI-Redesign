      "scene": {
        "schemaVersion": 1,
        "revision": 1,
        "listener": {
          "id": "listener-0",
          "type": "listener",
          "worldPosition": { "x": 0, "y": 0, "z": 0 },
          "orientation": { "w": 1, "x": 0, "y": 0, "z": 0 },
          "enabled": true,
          "active": true
        },
        "sources": [
          {
            "id": "source-0",
            "type": "source",
            "worldPosition": { "x": 0, "y": 0, "z": -1.8 },
            "enabled": true,
            "active": true
          }
        ],
        "emitters": []
      },
      "expect": { "valid": true }
    },
