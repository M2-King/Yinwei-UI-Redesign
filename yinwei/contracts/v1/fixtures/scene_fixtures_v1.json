{
  "schemaId": "SceneContractV1",
  "schemaVersion": 1,
  "forbiddenTopLevelKeys": [
    "camera",
    "selection",
    "hover",
    "drag",
    "telemetry",
    "audio",
    "spatialParams",
    "arrayLayout"
  ],
  "cases": [
