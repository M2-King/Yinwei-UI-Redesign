        "sources": [
          {
            "id": "source-0",
            "type": "source",
            "worldPosition": { "x": "NaN", "y": 0, "z": 0 },
            "enabled": true,
            "active": true
          }
        ],
        "emitters": []
      },
      "expect": { "valid": false, "reason": "non_finite_position" }
