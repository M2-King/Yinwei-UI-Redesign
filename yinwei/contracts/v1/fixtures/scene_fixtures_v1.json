          { "id": "emitter-LFE", "type": "emitter", "worldPosition": { "x": 0, "y": -0.7986355100472928, "z": -1.5011309545689827 }, "enabled": true, "active": true, "visualRole": "LFE" },
          { "id": "emitter-Ls", "type": "emitter", "worldPosition": { "x": -2, "y": 0, "z": 0 }, "enabled": true, "active": true, "visualRole": "Ls" },
