      "kind": "validate",
      "scene": {
        "schemaVersion": 1,
        "revision": 1,
        "listener": {
          "id": "listener-0",
          "type": "listener",
          "worldPosition": { "x": 0, "y": 0, "z": 0 },
          "enabled": true,
          "active": true
