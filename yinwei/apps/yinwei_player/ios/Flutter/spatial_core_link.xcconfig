// Frameworks required by cpal/CoreAudio when Runner force-loads spatial_core.
// Optional force-load flags are generated by tools/build_native_ios.sh into
// spatial_core_force_load.xcconfig so a missing archive does not break the
// first Xcode compile (Dart then reports Mock honestly).
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -framework AVFoundation -framework AudioToolbox -framework CoreAudio -framework Accelerate -lc++
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -framework AVFoundation -framework AudioToolbox -framework CoreAudio -framework Accelerate -lc++
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development
