// Frameworks + -force_load live in generated spatial_core_force_load.xcconfig
// as SPATIAL_CORE_FORCE_LDFLAGS so they append instead of replacing Flutter
// OTHER_LDFLAGS. A missing archive does not break the first Xcode compile
// (Dart then reports Mock honestly).
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development
